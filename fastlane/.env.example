# beta 레인 실행에 필요한 환경변수 템플릿.
# 로컬: 이 파일을 `fastlane/.env`로 복사해 값을 채운다(.env는 .gitignore로 커밋 제외).
# CI:   아래 키들을 GitHub Secrets에 등록한다(deploy.yml이 env로 주입).
#
#   cp fastlane/.env.example fastlane/.env

# ── App Store Connect API Key (Apple ID+2FA 대신 CI에서 동작하는 인증) ──
# ASC → 사용자와 액세스 → 통합 → App Store Connect API 에서 발급.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# .p8 파일 내용을 base64로 인코딩한 문자열 (Fastfile에서 is_key_content_base64: true)
#   base64 -i AuthKey_XXXXXXXXXX.p8 | pbcopy
ASC_KEY_CONTENT=BASE64_ENCODED_P8_CONTENT

# ── match (서명 자산 복호화·certs repo 접근) ──
# match appstore 최초 실행 때 정한 암호.
MATCH_PASSWORD=your-match-passphrase
# certs repo가 private일 때 접근용. GitHub은 "x-access-token:<PAT>" 를 base64 한 값.
#   echo -n "x-access-token:ghp_xxx" | base64
MATCH_GIT_BASIC_AUTHORIZATION=BASE64_TOKEN
# (선택) certs repo URL을 Matchfile 기본값 대신 덮어쓸 때.
# MATCH_GIT_URL=https://github.com/xngsoo/booknaru-certificates
